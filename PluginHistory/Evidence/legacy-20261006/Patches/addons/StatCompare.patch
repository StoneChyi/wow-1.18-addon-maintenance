+end
+local function PackProfileResults(...) return arg end
+-- Lua 5.0's unpack accepts only the table; it ignores start/end arguments.
+-- Expand an explicit range ourselves, preserving nil holes and return counts.
+local function UnpackProfileRange(values, first, last)
+    if first > last then return end
+    return values[first], UnpackProfileRange(values, first+1, last)
+end
+function SCProfileNextCharacterOpen()
+    if openProfile then StopOpenProfile(false); ProfileMessage("已取消采样。"); return end
+    if type(debugprofilestop) ~= "function" then
+        ProfileMessage("当前客户端没有精确计时接口，无法提供可靠耗时。"); return
+    end
+    local sample = {hooks={}, entries={}, elapsed=0}
+    openProfile = sample
+    local function Install(owner, key, label, script, after)
+        if not owner then return end
+        local previous = script and owner:GetScript(key) or owner[key]
+        if type(previous) ~= "function" then return end
+        local entry = {label=label, ms=0, calls=0}
+        table.insert(sample.entries, entry)
+        local wrapper = function(...)
+            if script and not sample.started then
+                sample.started = true
+                profileTimer = profileTimer or CreateFrame("Frame")
+                profileTimer:SetScript("OnUpdate", function()
+                    sample.elapsed = sample.elapsed + (arg1 or 0)
+                    if sample.elapsed >= 0.3 then StopOpenProfile(true) end
+                end)
+            end
+            if not sample.started or openProfile ~= sample then return previous(UnpackProfileRange(arg,1,arg.n)) end
+            local memoryBefore = script and type(gcinfo) == "function" and gcinfo()
+            local started = debugprofilestop()
+            local span = {parent=sample.current,children=0}
+            sample.current = span
+            local results = PackProfileResults(pcall(previous,UnpackProfileRange(arg,1,arg.n)))
+            local elapsed = math.max(0, debugprofilestop()-started)
+            sample.current = span.parent
+            if span.parent then span.parent.children = span.parent.children + elapsed end
+            entry.ms = entry.ms + elapsed
+            entry.selfMs = (entry.selfMs or 0) + math.max(0,elapsed-span.children)
+            entry.calls = entry.calls + 1
+            if type(memoryBefore) == "number" then
+                local memoryAfter = gcinfo()
+                if type(memoryAfter) == "number" and memoryAfter < memoryBefore then
+                    entry.memoryDrop = (entry.memoryDrop or 0) + memoryBefore - memoryAfter
+                end
+            end
+            if not results[1] then StopOpenProfile(false); error(results[2],0) end
+            if after then after(UnpackProfileRange(results,2,results.n)) end
+            return UnpackProfileRange(results,2,results.n)
+        end
+        table.insert(sample.hooks,{owner=owner,key=key,previous=previous,wrapper=wrapper,script=script})
+        if script then owner:SetScript(key,wrapper) else owner[key]=wrapper end
+    end
