+function C:GraphNote(module,graph)
+    if not graph then return false end
+    local scope=self:Scope(module.encounterKey or 1)
+    if scope then
+        graph:Hide()
+        if not graph.encounterNote then
+            local parent=graph:GetParent()
+            graph.encounterNote=parent:CreateFontString(nil,"OVERLAY","GameFontNormal")
+            graph.encounterNote:SetPoint("CENTER",graph,"CENTER",0,0)
+            graph.encounterNote:SetWidth(300)
+        end
+        graph.encounterNote:SetText(self:ScopeName(module.encounterKey or 1).."\n累计范围无单场时间轴；查看曲线请选择当前或历史战斗。")
+        graph.encounterNote:Show()
+        return true
+    elseif graph.encounterNote then graph.encounterNote:Hide() end
+    return false
+end
