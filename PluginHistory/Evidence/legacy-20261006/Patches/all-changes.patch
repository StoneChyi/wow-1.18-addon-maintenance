+    return SealManaCost(name, rank, threshold > 0 and threshold or 170)
+end
+
+local function CanPrepareSeal(name, threshold)
+    return MPGetGCD() > 1.4 and MPSpellReady(name) and Mana >= PreparingSealCost(name, threshold)
