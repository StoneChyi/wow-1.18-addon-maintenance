+function C:Normalize(key)
+    local scope=self:Scope(key)
+    if scope and self:ValidateScope(key,scope.."all")=="currentfight" then
+        D.Options:ToggleSegment(key,"currentfight")
+        return nil
+    end
+    return scope
+end
