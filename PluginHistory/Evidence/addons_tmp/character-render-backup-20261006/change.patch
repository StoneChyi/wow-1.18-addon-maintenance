 local function SameNumber(a, b)
     return a == b or (type(a) == "number" and type(b) == "number" and math.abs(a-b) < 0.000001)
+end
+function SCSetPanelPoint(frame, point, relative, relativePoint, x, y)
+    if type(relative) == "string" then relative = getglobal(relative) end
+    local p, r, rp, ox, oy = frame:GetPoint()
+    if type(r) == "string" then r = getglobal(r) end
+    if p == point and r == relative and rp == relativePoint and SameNumber(ox,x) and SameNumber(oy,y)
+        and (not frame.GetNumPoints or frame:GetNumPoints() == 1) then return end
+    frame:ClearAllPoints()
+    frame:SetPoint(point, relative, relativePoint, x, y)
+end
+function SCSetPanelText(fontString, value)
+    value = tostring(value or "")
+    if fontString:GetText() ~= value then fontString:SetText(value) end
+end
+function SCGetPanelTextSize(fontString)
+    local file, size, flags = fontString:GetFont()
+    local content = fontString:GetText()
+    local measured = fontString.scMeasuredContent
+    if measured and measured.text == content and measured.file == file
+        and measured.size == size and measured.flags == flags then
+        return measured.width, measured.height
+    end
+    local width, height = fontString:GetWidth(), fontString:GetHeight()
+    fontString.scMeasuredContent = {text=content, file=file, size=size, flags=flags, width=width, height=height}
+    return width, height
 end
 local function SameBackdrop(a, b)
     if not a or not b then return a == b end
