+-- Cache raw equipment only: buff scanners mutate the working tables later.
+local playerEquipmentCache
+local equipmentCacheFields = {
+    "StatScanner_bonuses", "StatScanner_sets", "StatScanner_setcount",
+    "StatScanner_setsproperty", "StatScanner_currentset", "StatScanner_currentsetcount"
+}
+
+local function CopyEquipmentData(value)
+    if type(value) ~= "table" then return value end
+    local copy = {}
+    for key, entry in pairs(value) do copy[key] = CopyEquipmentData(entry) end
+    return copy
+end
+
+function StatScanner_InvalidatePlayerCache()
+    playerEquipmentCache = nil
+end
+
+local function PlayerEquipmentKey()
+    local parts = { tostring(UnitLevel("player")) }
+    local ready = true
+    for slot = 1, 19 do
+        local link = GetInventoryItemLink("player", slot)
+        parts[slot + 1] = link or ""
+        if link then
+            local _, _, itemID = string.find(link, "item:(%d+)")
+            if not itemID or not GetItemInfo(tonumber(itemID)) then ready = false end
+        elseif GetInventoryItemTexture("player", slot) then
+            -- Retry when an equipped item has not supplied its link yet.
+            ready = false
+        end
+    end
+    return table.concat(parts, "\n"), ready
+end
