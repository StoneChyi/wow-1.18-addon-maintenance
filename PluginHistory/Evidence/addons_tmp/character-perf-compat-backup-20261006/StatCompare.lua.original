-- ===== 属性面板公共布局（随主文件加载） =====
if not SCGetPanelLayoutMode then
-- 装备列表与属性面板共用的布局、背景管理。自动布局不覆盖原有自由拖动位置。
function SCGetPanelLayoutMode()
    return StatCompare_Player and StatCompare_Player.PanelLayoutMode == "free" and "free" or "auto"
end

function SCIsManagedPanel(frame)
    return frame and (frame == StatCompareSelfFrame or frame == StatCompareTargetFrame)
end

local function Visible(frame)
    return frame and frame:IsVisible()
end

local fallbackBackdrop = {bgFile="Interface\\BUTTONS\\WHITE8X8",
    edgeFile="Interface\\BUTTONS\\WHITE8X8", edgeSize=1,
    insets={left=0, right=0, top=0, bottom=0}}
local function SameNumber(a, b)
    return a == b or (type(a) == "number" and type(b) == "number" and math.abs(a-b) < 0.000001)
end
local function SameBackdrop(a, b)
    if not a or not b then return a == b end
    if a.bgFile ~= b.bgFile or a.edgeFile ~= b.edgeFile or (not not a.tile) ~= (not not b.tile)
        or not SameNumber(a.tileSize or 0, b.tileSize or 0)
        or not SameNumber(a.edgeSize or 0, b.edgeSize or 0) then return false end
    local ai, bi = a.insets or {}, b.insets or {}
    return SameNumber(ai.left or 0, bi.left or 0) and SameNumber(ai.right or 0, bi.right or 0)
        and SameNumber(ai.top or 0, bi.top or 0) and SameNumber(ai.bottom or 0, bi.bottom or 0)
end
local function ApplyColor(background, border, r, g, b, a)
    local cr, cg, cb, ca
    if border then cr, cg, cb, ca = background:GetBackdropBorderColor()
    else cr, cg, cb, ca = background:GetBackdropColor() end
    if SameNumber(cr,r) and SameNumber(cg,g) and SameNumber(cb,b) and SameNumber(ca,a) then return end
    if border then background:SetBackdropBorderColor(r,g,b,a)
    else background:SetBackdropColor(r,g,b,a) end
end

function SCApplyPanelStyle(frame)
    if not frame then return end
    local reference = CharacterFrame and (CharacterFrame.backdrop or (CharacterFrame:GetBackdrop() and CharacterFrame))
        or InspectFrame and (InspectFrame.backdrop or (InspectFrame:GetBackdrop() and InspectFrame))
    local background = frame.backdrop or frame
    local r, g, b, a = 0, 0, 0, 0.75
    local er, eg, eb, ea = 0.4, 0.4, 0.4, 1
    local desiredBackdrop = fallbackBackdrop
    if reference then
        desiredBackdrop = reference:GetBackdrop()
        r, g, b, a = reference:GetBackdropColor()
        er, eg, eb, ea = reference:GetBackdropBorderColor()
    end
    if not SameBackdrop(background:GetBackdrop(), desiredBackdrop) then background:SetBackdrop(desiredBackdrop) end
    -- pfUI 的子背景与原始框体背景只能保留一层，否则透明度会叠加。
    if background ~= frame and frame:GetBackdrop() then frame:SetBackdrop(nil) end
    local backdropAlpha = reference and reference:GetAlpha() or 1
    if background ~= frame then
        if not SameNumber(background:GetAlpha(), backdropAlpha) then background:SetAlpha(backdropAlpha) end
    elseif reference ~= CharacterFrame then a = a * backdropAlpha end
    ApplyColor(background, false, r, g, b, a)
    ApplyColor(background, true, er, eg, eb, ea)
    local alpha = CharacterFrame and CharacterFrame:GetAlpha() or 1
    if not SameNumber(frame:GetAlpha(), alpha) then frame:SetAlpha(alpha) end
end

local layoutFrame, inLayout, suspendedPanels, suspendedRoot
local function HookLifecycle(frame)
    if not frame or frame._scLayoutHooked then return end
    frame._scLayoutHooked = true
    local function Hook(script)
        local previous = frame:GetScript(script)
        frame:SetScript(script, function(self, arg1, arg2)
            if previous then previous(self, arg1, arg2) end
            SCRequestPanelLayout()
        end)
    end
    Hook("OnShow")
    Hook("OnHide")
    Hook("OnSizeChanged")
end

function SCRequestPanelLayout()
    -- Layout writes can fire OnSizeChanged. Do not queue another layout for
    -- our own changes; otherwise reanchoring can keep it running every frame.
    if inLayout then return end
    if not layoutFrame then
        layoutFrame = CreateFrame("Frame")
        layoutFrame:RegisterEvent("PLAYER_ENTERING_WORLD")
        layoutFrame:RegisterEvent("ADDON_LOADED")
        layoutFrame:SetScript("OnEvent", function() SCRequestPanelLayout() end)
    end
    -- 等当前显示/隐藏调用完成后统一排列，避免钩子调用顺序改变结果。
    layoutFrame:SetScript("OnUpdate", function()
        layoutFrame:SetScript("OnUpdate", nil)
        SCRelayoutPanels()
    end)
end

function SCRelayoutPanels()
    if inLayout then return end
    inLayout = true
    HookLifecycle(CharacterFrame)
    HookLifecycle(PaperDollFrame)
    HookLifecycle(InspectFrame)
    HookLifecycle(InspectPaperDollFrame)
    HookLifecycle(OutfitterFrame)
    HookLifecycle(S_ItemTip_InspectFrame)
    HookLifecycle(StatCompareTargetFrame)
    HookLifecycle(StatCompareSelfFrame)
    SCEnsureSettingsButton()
    SCApplyPanelStyle(S_ItemTip_InspectFrame)
    SCApplyPanelStyle(StatCompareTargetFrame)
    SCApplyPanelStyle(StatCompareSelfFrame)

    local root, inspecting
    if Visible(InspectFrame) and InspectFrame.unit then
        if not InspectPaperDollFrame or Visible(InspectPaperDollFrame) then
            root, inspecting = InspectFrame, true
        end
    elseif Visible(CharacterFrame) and Visible(PaperDollFrame) then
        root = CharacterFrame
    end
    if not root or Visible(OutfitterFrame) then
        local owner = Visible(InspectFrame) and InspectFrame.unit and InspectFrame
            or Visible(CharacterFrame) and CharacterFrame
        if owner then
            if suspendedRoot ~= owner then
                suspendedRoot = owner
                suspendedPanels = {equipment=Visible(S_ItemTip_InspectFrame),
                    target=Visible(StatCompareTargetFrame), self=Visible(StatCompareSelfFrame)}
            end
        else suspendedPanels, suspendedRoot = nil, nil end
        if S_ItemTip_InspectFrame then S_ItemTip_InspectFrame:Hide() end
        if StatCompareTargetFrame then StatCompareTargetFrame:Hide() end
        if StatCompareSelfFrame then StatCompareSelfFrame:Hide() end
        inLayout = nil
        return
    end
    if suspendedPanels and suspendedRoot == root then
        if suspendedPanels.equipment and S_ItemTip_InspectFrame then S_ItemTip_InspectFrame:Show() end
        if suspendedPanels.target and inspecting and StatCompareTargetFrame then StatCompareTargetFrame:Show() end
        if suspendedPanels.self and StatCompareSelfFrame then StatCompareSelfFrame:Show() end
    end
    suspendedPanels, suspendedRoot = nil, nil
    if not inspecting and StatCompareTargetFrame then
        -- 目标框体的原始 OnHide 会连带隐藏自身框体，切回角色页时保留其显示状态。
        local selfShown = Visible(StatCompareSelfFrame)
        StatCompareTargetFrame:Hide()
        if selfShown then StatCompareSelfFrame:Show() end
    end
    if inspecting and StatCompare_GetSetting and StatCompare_GetSetting("ShowSelfFrame") == 0
        and StatCompareSelfFrame then StatCompareSelfFrame:Hide() end
    if S_ItemTip_Settings and S_ItemTip_Settings.showInspect == false and S_ItemTip_InspectFrame then
        S_ItemTip_InspectFrame:Hide()
    end
    if SCGetPanelLayoutMode() == "free" then inLayout = nil; return end

    local anchor = root.backdrop or root
    local x, y = root.backdrop and 4 or -26, root.backdrop and 0 or -10
    local function Attach(frame)
        if not Visible(frame) then return end
        local point, relative, relativePoint, ox, oy = frame:GetPoint()
        if type(relative) == "string" then relative = getglobal(relative) end
        if point ~= "TOPLEFT" or relative ~= anchor or relativePoint ~= "TOPRIGHT"
            or not SameNumber(ox,x) or not SameNumber(oy,y)
            or (frame.GetNumPoints and frame:GetNumPoints() ~= 1) then
            frame:ClearAllPoints()
            frame:SetPoint("TOPLEFT", anchor, "TOPRIGHT", x, y)
        end
        if frame:GetFrameStrata() ~= root:GetFrameStrata() then frame:SetFrameStrata(root:GetFrameStrata()) end
        anchor, x, y = frame, 4, 0
    end
    Attach(S_ItemTip_InspectFrame)
    if inspecting then Attach(StatCompareTargetFrame) end
    Attach(StatCompareSelfFrame)
    inLayout = nil
end

function SCSetPanelLayoutMode(mode)
    if mode ~= "auto" and mode ~= "free" then return end
    StatCompare_Player = StatCompare_Player or {}
    StatCompare_Player.PanelLayoutMode = mode
    if mode == "free" and StatCompare_RestoreFramePosition then
        StatCompare_RestoreFramePosition("StatCompareTargetFrame")
        StatCompare_RestoreFramePosition("StatCompareSelfFrame")
    end
    SCRelayoutPanels()
    SCRequestPanelLayout()
    if StatCompareLayoutButton then
        StatCompareLayoutButton:SetText(mode == "auto" and "排列：自动" or "排列：自由拖动")
    end
end

function SCEnsureLayoutButton()
    if not StatCompareOptFrame then return end
    if not StatCompareLayoutButton then
        local button = CreateFrame("Button", "StatCompareLayoutButton", StatCompareOptFrame, "GameMenuButtonTemplate")
        button:SetWidth(130)
        button:SetHeight(24)
        button:SetPoint("BOTTOMRIGHT", StatCompareOkButton, "BOTTOMLEFT", -8, 0)
        button:SetScript("OnClick", function()
            SCSetPanelLayoutMode(SCGetPanelLayoutMode() == "auto" and "free" or "auto")
        end)
    end
    StatCompareLayoutButton:SetText(SCGetPanelLayoutMode() == "auto" and "排列：自动" or "排列：自由拖动")
end

function SCEnsureSettingsButton()
    if not StatCompareSelfFrame or StatCompareSelfFrameSettingsButton then return end
    local button = CreateFrame("Button", "StatCompareSelfFrameSettingsButton", StatCompareSelfFrame)
    button:SetWidth(36)
    button:SetHeight(16)
    if StatCompareSelfFrameSpellsButton then
        button:SetPoint("RIGHT", StatCompareSelfFrameSpellsButton, "LEFT", -5, 0)
    else
        button:SetPoint("TOPRIGHT", StatCompareSelfFrame, "TOPRIGHT", -49, -7)
    end
    button:SetBackdrop({bgFile="Interface\\BUTTONS\\WHITE8X8",
        edgeFile="Interface\\BUTTONS\\WHITE8X8", edgeSize=1,
        insets={left=1, right=1, top=1, bottom=1}})
    button:SetBackdropColor(0.12, 0.12, 0.12, 0.75)
    button:SetBackdropBorderColor(0.4, 0.4, 0.4, 1)
    local label = button:CreateFontString(nil, "OVERLAY", "GameFontNormalSmall")
    label:SetPoint("CENTER", button, "CENTER", 0, 0)
    label:SetText("设置")
    button:SetScript("OnClick", function()
        if StatCompare_Toggle then StatCompare_Toggle() end
    end)
    button:SetScript("OnEnter", function() button:SetBackdropColor(0.25, 0.25, 0.25, 0.9) end)
    button:SetScript("OnLeave", function() button:SetBackdropColor(0.12, 0.12, 0.12, 0.75) end)
end

-- Opt-in, one-opening measurement. No timing hooks are installed normally.
local openProfile
local profileTimer
local function ProfileMessage(message)
    DEFAULT_CHAT_FRAME:AddMessage("|cff33ccff面板耗时：|r" .. message)
end
local function StopOpenProfile(report)
    local sample = openProfile
    if not sample then return end
    openProfile = nil
    if profileTimer then profileTimer:SetScript("OnUpdate", nil) end
    for _, hook in ipairs(sample.hooks) do
        if hook.script then
            if hook.owner:GetScript(hook.key) == hook.wrapper then hook.owner:SetScript(hook.key, hook.previous) end
        elseif hook.owner[hook.key] == hook.wrapper then hook.owner[hook.key] = hook.previous end
    end
    if not report then return end
    ProfileMessage("本次打开及随后 0.3 秒内的界面处理（毫秒）：")
    for _, entry in ipairs(sample.entries) do
        if entry.calls > 0 then
            ProfileMessage(string.format("%s：%.2f ms / %d 次", entry.label, entry.ms, entry.calls))
        end
    end
    ProfileMessage("分项包含内部调用，不能相加；采样已自动关闭。")
end
local function PackProfileResults(...) return arg end
function SCProfileNextCharacterOpen()
    if openProfile then StopOpenProfile(false); ProfileMessage("已取消采样。"); return end
    if type(debugprofilestop) ~= "function" then
        ProfileMessage("当前客户端没有精确计时接口，无法提供可靠耗时。"); return
    end
    local sample = {hooks={}, entries={}, elapsed=0}
    openProfile = sample
    local function Install(owner, key, label, script)
        if not owner then return end
        local previous = script and owner:GetScript(key) or owner[key]
        if type(previous) ~= "function" then return end
        local entry = {label=label, ms=0, calls=0}
        table.insert(sample.entries, entry)
        local wrapper = function(...)
            if script and not sample.started then
                sample.started = true
                profileTimer = profileTimer or CreateFrame("Frame")
                profileTimer:SetScript("OnUpdate", function()
                    sample.elapsed = sample.elapsed + (arg1 or 0)
                    if sample.elapsed >= 0.3 then StopOpenProfile(true) end
                end)
            end
            if not sample.started or openProfile ~= sample then return previous(unpack(arg,1,arg.n)) end
            local started = debugprofilestop()
            local results = PackProfileResults(pcall(previous,unpack(arg,1,arg.n)))
            entry.ms = entry.ms + math.max(0, debugprofilestop()-started)
            entry.calls = entry.calls + 1
            if not results[1] then StopOpenProfile(false); error(results[2],0) end
            return unpack(results,2,results.n)
        end
        table.insert(sample.hooks,{owner=owner,key=key,previous=previous,wrapper=wrapper,script=script})
        if script then owner:SetScript(key,wrapper) else owner[key]=wrapper end
    end
    Install(CharacterFrame,"OnShow","角色窗口打开回调",true)
    Install(PaperDollFrame,"OnShow","角色属性页打开回调",true)
    Install(_G,"oldPaperDollFrame_OnShow","StatCompare 调用的原有打开处理")
    Install(_G,"StatScanner_ScanAll","装备提示文本扫描")
    Install(_G,"SC_BuffScanner_ScanAllInspect","增益扫描")
    Install(_G,"StatCompare_CharStats_Scan","属性计算")
    Install(_G,"StatCompare_GetTooltipText","属性文字生成")
    Install(_G,"SCShowFrame","属性副面板显示")
    Install(_G,"S_ItemTip_UpdateFrame","装备列表与附魔刷新")
    Install(ItemSocre,"ScanUnit","装等计算")
    Install(BCS,"UpdateStats","BCS 角色属性刷新")
    Install(BCS and BCS.PropertiesPanel,"GetDisplayLines","浮动属性内容计算")
    Install(_G,"SCRelayoutPanels","面板布局")
    ProfileMessage("已准备采样，请关闭角色窗口，再按 C 打开一次。结果会自动显示。")
end

end
