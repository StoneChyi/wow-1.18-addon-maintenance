	local extraHeight = 80  -- 头像和等级区域的高度
	if IsAddOnLoaded("S_ItemTip") then
		local score = ItemSocre:ScanUnit("target")
		if score and score > 0 then
			StatCompareTargetFrame:SetHeight(height + extraHeight + 30)
