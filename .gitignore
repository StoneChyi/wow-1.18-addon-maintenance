# Only plugin code, runtime dependencies and maintenance records belong here.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/Interface/
/Interface/*
!/Interface/AddOns/
!/PluginHistory/
!/Tools/
!/*.dll
!/dlls.txt
!/dxvk.conf

# Generated maintenance files and temporary update packages.
/Tools/**/__pycache__/
/Tools/**/*.pyc
/PluginHistory/staging/
/PluginHistory/check-results/
